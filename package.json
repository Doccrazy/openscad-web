{
  "name": "openscad-web",
  "version": "0.1.0",
  "description": "Standalone OpenSCAD language interpreter, CSG evaluator and WebGL2 viewer for the web",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lang": {
      "types": "./dist/types/lang/index.d.ts",
      "import": "./dist/lang.js"
    },
    "./eval": {
      "types": "./dist/types/eval/index.d.ts",
      "import": "./dist/eval.js"
    },
    "./geometry": {
      "types": "./dist/types/geometry/index.d.ts",
      "import": "./dist/geometry.js"
    },
    "./engine": {
      "types": "./dist/types/engine/index.d.ts",
      "import": "./dist/engine.js"
    },
    "./customizer": {
      "types": "./dist/types/customizer/index.d.ts",
      "import": "./dist/customizer.js"
    },
    "./viewer": {
      "types": "./dist/types/viewer/index.d.ts",
      "import": "./dist/viewer.js"
    },
    "./worker": {
      "import": "./dist/worker.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/arimo": "^5.3.0",
    "manifold-3d": "^3.5.4",
    "opentype.js": "^2.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "codemirror": "^6.0.2",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./dist/worker.js",
    "./src/engine/worker.ts"
  ]
}
